<?xml version="1.0"?>
<robot name="scara_wafer_robot">
  <!-- Base Ground Anchor -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.10"/>
      </geometry>
      <material name="dark_gray"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Joint 1: Shoulder -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="150" velocity="4.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Link 1: Inner Arm (L1 = 0.40m, Z in [0.005, 0.045]m) -->
  <link name="link1">
    <visual>
      <origin xyz="0.20 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.40" radius="0.020"/>
      </geometry>
      <material name="silver"><color rgba="0.7 0.7 0.75 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.20 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.40" radius="0.020"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.20 0 0"/>
      <mass value="4.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.06"/>
    </inertial>
  </link>

  <!-- Joint 2: Elbow -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.40 0 0.035" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="100" velocity="4.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Link 2: Forearm (L2 = 0.35m, Z in [0.045, 0.075]m) -->
  <link name="link2">
    <visual>
      <origin xyz="0.175 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.35" radius="0.015"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.175 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.35" radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.175 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.035" iyz="0" izz="0.035"/>
    </inertial>
  </link>

  <!-- Joint 3: Wrist (Elevated Spindle Flange, Z = 0.085m) -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="paddle_link"/>
    <origin xyz="0.35 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="6.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Link 3: Wafer Paddle Blade (L3 = 0.15m to wafer COM, Z in [0.080, 0.090]m) -->
  <link name="paddle_link">
    <!-- Box Primitive: 320mm x 200mm x 10mm calibrated blade -->
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.32 0.20 0.010"/>
      </geometry>
      <material name="white"><color rgba="0.9 0.9 0.9 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.32 0.20 0.010"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.15 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.015"/>
    </inertial>
  </link>
</robot>
